{
  "markdown": [
    {
      "trigger": "todo",
      "name": "add TODO comment",
      "description": "add TODO comment",
      "body": ["<!-- TODO: $0 -->"]
    },
    {
      "trigger": "note",
      "name": "add NOTE comment",
      "description": "add NOTE comment",
      "body": ["<!-- NOTE: $0 -->"]
    },
    {
      "trigger": "meta",
      "name": "Metadata",
      "description": "YAML metadata format for markdown",
      "body": [
        "---",
        "title: ${1:note_title}",
        "author: ${2:author}",
        "date: ${3:date}",
        "categories: [${4}]",
        "lastmod: ${5:date}",
        "tags: [${6}]",
        "comments: true",
        "---",
        "",
        "$0"
      ]
    }
  ]
}
