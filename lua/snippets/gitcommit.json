{
  "gitcommit": [
    {
      "trigger": "todo",
      "name": "add TODO comment",
      "description": "add TODO comment",
      "body": ["# TODO: $0"]
    },
    {
      "trigger": "note",
      "name": "add NOTE comment",
      "description": "add NOTE comment",
      "body": ["# NOTE: $0"]
    },
    {
      "trigger": "revert",
      "name": "revert conventional commit",
      "description": "revert conventional commit",
      "body": ["revert(${1:scope}): ${2:title}$0"]
    }
  ]
}
